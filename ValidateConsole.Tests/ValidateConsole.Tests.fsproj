<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <!-- Must match ValidateConsole: it references the 32-bit-only Jet provider. -->
        <RuntimeIdentifier>win-x86</RuntimeIdentifier>
        <SelfContained>false</SelfContained>
        <!-- xunit v3 runs on Microsoft.Testing.Platform, not VSTest. The opt-in lives in
             dotnet.config at the repo root; on VSTest `dotnet test` hangs with no adapter. -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="DbValidationTests.fs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" Version="4.0.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ValidateConsole\ValidateConsole.fsproj" />
    </ItemGroup>

</Project>
