<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <!-- The Access files are Jet 3 (Access 97). ACE x64 refuses them outright;
             only the 32-bit Microsoft.Jet.OLEDB.4.0 provider can open them, so this
             app has to run as x86. Requires the x86 .NET 10 runtime. -->
        <RuntimeIdentifier>win-x86</RuntimeIdentifier>
        <SelfContained>false</SelfContained>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="AccessDb.fs" />
        <Compile Include="AccessDbSchema.fs" />
        <Compile Include="AccessDbDump.fs" />
        <Compile Include="DbValidation.fs" />
        <Compile Include="DownloadUtils.fs" />
        <Compile Include="StevneXml.fs" />
        <Compile Include="ValidationMain.fs" />
        <Compile Include="Program.fs"/>
        <Folder Include="Sample\" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="FSharp.Data" Version="6.6.0" />
      <PackageReference Include="System.Data.OleDb" Version="10.0.12" />
    </ItemGroup>

</Project>
